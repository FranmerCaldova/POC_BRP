/// Direct Lake source: POC_claim_rate_actuals. Current-run measures isolate published facts.
table 'Actual Claim Rates'

	/// Observed events by the selected horizon divided by initial population; not KM.
	measure 'Observed Claim Fraction' =
			IF(HASONEVALUE('Products'[Product Line]) && HASONEVALUE('Event Types'[Event Type]) && HASONEVALUE('Failure Curves'[Model Year]) && HASONEVALUE('Failure Curves'[Axis]) && HASONEVALUE('Failure Curves'[Horizon]),
			    VAR _run = [Published Run]
			    VAR _axis = SELECTEDVALUE('Failure Curves'[Axis])
			    VAR _horizon = SELECTEDVALUE('Failure Curves'[Horizon])
			    RETURN CALCULATE(SELECTEDVALUE('Actual Claim Rates'[Observed Fraction]),
			        TREATAS({ _run }, 'Actual Claim Rates'[Run Id]),
			        TREATAS({ _axis }, 'Actual Claim Rates'[Axis]),
			        TREATAS({ _horizon }, 'Actual Claim Rates'[Horizon]))
			)
		formatString: 0.00%

	column 'Product Line'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: product_line

	column 'Model Year'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: model_year

	column 'Event Type'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: event_type

	column 'Run Id'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: run_id

	column Axis
		dataType: string
		summarizeBy: none
		sourceColumn: axis

	column Horizon
		dataType: double
		summarizeBy: none
		sourceColumn: horizon

	column 'Observed Fraction'
		dataType: double
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: observed_claim_fraction

	partition 'Actual Claim Rates' = entity
		mode: directLake
		source
			entityName: POC_claim_rate_actuals
			expressionSource: 'Direct Lake Gold'

